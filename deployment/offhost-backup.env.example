# Copy to /etc/veridra/offhost-backup.env on the production host.
# chmod 600 /etc/veridra/offhost-backup.env
# Do not commit the real file or any value below.

# Backblaze B2 S3-compatible restic repository.
# Use the actual EU Central S3 endpoint shown by the created B2 account/bucket.
RESTIC_REPOSITORY=s3:https://s3.ACTUAL-EU-REGION.backblazeb2.com/ACTUAL-BUCKET/veridra
AWS_DEFAULT_REGION=ACTUAL-EU-REGION

# Dedicated least-privilege B2 application key ID + secret.
AWS_ACCESS_KEY_ID=replace-locally
AWS_SECRET_ACCESS_KEY=replace-locally

# Independent client-side encryption password file. Keep a separate recovery copy.
RESTIC_PASSWORD_FILE=/etc/veridra/restic-password

# Local verified application ZIP directory.
VERIDRA_BACKUP_DIR=/opt/veridra-backups
