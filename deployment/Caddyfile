{$VERIDRA_DOMAIN} {
    encode zstd gzip

    log {
        output stdout
        format filter {
            request>uri query {
                replace token REDACTED
            }
            request>remote_ip delete
            request>client_ip delete
            request>headers>X-Forwarded-For delete
        }
    }

    reverse_proxy web:8000 {
        header_up -Forwarded
        header_up -X-Forwarded-*

        health_uri /health/ready
        health_interval 30s
        health_timeout 5s
        health_headers {
            Host {$VERIDRA_DOMAIN}
        }
    }
}
